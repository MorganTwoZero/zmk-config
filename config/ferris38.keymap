#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0

&sl { /delete-property/ quick-release; };

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp RET>;
            key-positions = <34 35>;
        };

        sticky_numlayer {
            bindings = <&holdtap_sticky_layer 1 1>;
            key-positions = <32 33>;
            layers = <0>;
        };

        escape_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <9 19>;
            layers = <0>;
        };

        brackets_combo {
            bindings = <&tap_prefrerred_holdtap RIGHT_BRACKET LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        tab_tilde_combo {
            bindings = <&mt GRAVE TAB>;
            key-positions = <9 10>;
        };
    };

    behaviors {
        tap_prefrerred_holdtap: tap_prefrerred_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFRERRED_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        td_player_controls: td_player_controls {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLAYER_CONTROLS";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp C_NEXT>, <&kp C_PREVIOUS>;

            tapping-term-ms = <300>;
        };

        holdtap_playr_ctl_or_vlm_ctl: holdtap_playr_ctl_or_vlm_ctl {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP_PLAYR_CTL_OR_VLM_CTL";
            bindings = <&mo>, <&td_player_controls>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        holdtap_sticky_layer: holdtap_sticky_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP_STICKY_LAYER";
            bindings = <&to>, <&sl>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        mod_morph_del: mod_morph_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_DEL";
            bindings = <&kp RIGHT>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RSFT|MOD_RGUI|MOD_RALT)>;
        };

        mod_morph_bckslsh: mod_morph_bckslsh {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_BCKSLSH";
            bindings = <&kp UP_ARROW>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RGUI|MOD_RALT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nested_holdtap: nested_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "NESTED_HOLDTAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&holdtap_macro>, <&kp>;
        };
    };

    macros {
        holdtap_macro: holdtap_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tap_prefrerred_holdtap RIGHT_BRACKET LEFT_BRACKET>;
            label = "HOLDTAP_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp W     &kp E      &kp R       &kp T        &kp Y                &kp U                            &kp I                            &kp O                                   &td_player_controls
&kp Q           &kp S     &kp D      &kp F       &kp G        &nested_holdtap 0 H  &tap_prefrerred_holdtap MINUS J  &tap_prefrerred_holdtap EQUAL K  &tap_prefrerred_holdtap SINGLE_QUOTE L  &kp P
&kp A           &kp X     &kp C      &kp V       &kp B        &kp N                &kp M                            &kp COMMA                        &kp DOT                                 &tap_prefrerred_holdtap FSLH SEMI
&mt LEFT_GUI Z  &kp LALT  &kp LCTRL  &kp LSHIFT  &kp SPACE    &kp BACKSPACE        &kp LEFT                         &kp DOWN                         &mod_morph_bckslsh                      &mod_morph_del
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP >;
        };

        numbers {
            bindings = <
              &kp N1        &kp N2            &kp N3          &kp DOT      &kp F1         &kp F2  &kp F3  &kp F10         &trans
&kp MINUS     &kp N4        &kp N5            &kp N6          &kp COMMA    &kp F4         &kp F5  &kp F6  &kp F11         &bt BT_NXT
&kp EQUAL     &kp N7        &kp N8            &kp N9          &kp N0       &kp F7         &kp F8  &kp F9  &kp F12         &bt BT_CLR
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &to 0        &kp BACKSPACE  &trans  &trans  &studio_unlock  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
