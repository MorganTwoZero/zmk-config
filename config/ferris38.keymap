#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0

/ {
    combos {
        compatible = "zmk,combos";

        winkey {
            bindings = <&sk LEFT_GUI>;
            key-positions = <28 29>;
        };

        enter {
            bindings = <&kp RET>;
            key-positions = <33 34>;
        };

        numlayer {
            bindings = <&to 1>;
            key-positions = <32 31>;
        };

        escape_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <8 18>;
            layers = <0>;
        };

        square_parenth_combo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        tab_tilde_combo {
            bindings = <&mt TILDE TAB>;
            key-positions = <8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp W     &kp E      &kp R       &kp T        &kp Y          &kp U        &kp I        &kp O
&kp Q           &kp S     &kp D      &kp F       &kp G        &kp H          &mt MINUS J  &mt EQUAL K  &mt SINGLE_QUOTE L  &kp P
&kp A           &kp X     &kp C      &kp V       &kp B        &kp N          &kp M        &kp COMMA    &kp DOT             &kp SEMI
&mt LEFT_GUI Z  &kp LALT  &kp LCTRL  &kp LSHIFT  &kp SPACE    &kp BACKSPACE  &kp LEFT     &kp DOWN     &kp UP              &kp FSLH
            >;
        };

        numbers {
            bindings = <
              &kp N1        &kp N2            &kp N3          &kp DOT      &kp F1         &kp F2  &kp F3  &kp F10
&kp MINUS     &kp N4        &kp N5            &kp N6          &kp COMMA    &kp F4         &kp F5  &kp F6  &kp F11     &trans
&kp EQUAL     &kp N7        &kp N8            &kp N9          &kp N0       &kp F7         &kp F8  &kp F9  &kp F12     &trans
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &to 0        &kp BACKSPACE  &trans  &trans  &bt BT_NXT  &bt BT_CLR_ALL
            >;
        };
    };
};
